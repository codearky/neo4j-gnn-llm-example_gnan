{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train STaRK QA - pyg_new",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "args": [
                "--checkpointing",
                "--llama_version", "llama3.1-8b",
                // "--llama_version", "tiny_llama",
                "--retrieval_config_version", "0",
                "--algo_config_version", "0",
                "--g_retriever_config_version", "0",
                "--eval_batch_size", "4",
                "--num_gnn_layers", "4",
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "CONDA_DEFAULT_ENV": "pyg_new",
                "NEO4J_URI": "bolt://localhost:7687",
                "NEO4J_USERNAME": "neo4j",
                "NEO4J_PASSWORD": "password"
            },
            "python": "/home/me.docker/.conda/envs/pyg_new/bin/python",
            "justMyCode": false,
            "stopOnEntry": false
        }, 
